# Copiar como .env y completar. Nunca se versiona con valores reales.
DJANGO_SECRET_KEY=generar-con-python-secrets-token-urlsafe-50
DJANGO_ALLOWED_HOSTS=piessanos.podocenter.pe
DJANGO_CSRF_ORIGINS=https://piessanos.podocenter.pe
# Clave de los datos clínicos cifrados: guárdela aparte. Si se pierde, los
# antecedentes y las observaciones ya guardados no se pueden leer.
CLAVE_CIFRADO_CAMPOS=generar-con-Fernet.generate_key
POSTGRES_HOST=podocenter.xxxxxxxx.sa-east-1.rds.amazonaws.com
POSTGRES_DB=podocenter
POSTGRES_USER=podo
POSTGRES_PASSWORD=

# Recordatorios por WhatsApp (RF07). Vacías, el envío es simulado. Se completan
# con la cuenta de WhatsApp Business aprobada por Meta (docs/DESPLIEGUE.md).
WHATSAPP_TOKEN=
WHATSAPP_NUMERO_ID=
WHATSAPP_VERSION_API=
WHATSAPP_PLANTILLA=
WHATSAPP_IDIOMA=es
